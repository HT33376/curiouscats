package launcherClassObjects;

import java.util.Random;

import javafx.animation.PauseTransition;
import javafx.scene.Scene;
import javafx.scene.image.Image;
import javafx.scene.image.ImageView;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;
import javafx.util.Duration;

import launcherClassObjects.ImageLogEntry.ImageCache;
import launcherClassObjects.ImageLogEntry;

public class RandomCats {
	
	private Random random = new Random();
	
	//This is the range/ total amount of pictures the program can choose from, update later
	final int MIN_VAL = 1;
	final int MAX_VAL = 5;
	//plus one because max val of random.nextInt is exclusive
	
	final int MAX_X_AXIS = 1100;
	final int MAX_Y_AXIS = 450;
	
	private Image catImage;
	ImageView catImgView;
	private String imageLocation = "/catLibrary/";
	
	//FIX CONSTRUCTOR LATER< DO NOT CONSTANTLY CREATE NEW IMAGES
	public RandomCats() {
		catLoader();//Preloads the cats 
		
        int num = 1 + random.nextInt(MAX_VAL); // pick 1 to 5
        String path = String.format("/catLibrary/%d.png", num);
        catImage = ImageCache.loadCachedImage(path); // ✅ Uses the cache
        catImgView = new ImageView(catImage);
		
		catImgView.setFitHeight(200);
		catImgView.setFitWidth(200);
	}
	
	//method is used in CountdownTimer class
	public void execute() {
    	//Size of popup window, this is why it is tiny
    	VBox box = new VBox();
    	box.getChildren().add(getCat());
  
    	Scene scene = new Scene(box,200,200);
    	Stage popUpStage =new Stage();
    	popUpStage.setScene(scene);
    	
    	//Window will pop up at random location throughout the screen
    	popUpStage.setX(random.nextInt(MAX_X_AXIS));
    	popUpStage.setY(random.nextInt(MAX_Y_AXIS));

    	popUpStage.show();
    	//Landmark: after show, send img to another method to display latest cat and that vbox
    	imageLogEntry(getCat());

    	PauseTransition delay = new PauseTransition(Duration.seconds(1.5));
    	delay.setOnFinished(event -> popUpStage.close());
    	delay.play();
	}
	
	
	public void catLoader() {
		for (int i = 1; i <= 5; i++) {
		    String path = String.format("/catLibrary/%d.png", i);
		    ImageCache.loadCachedImage(path); // 
		}

	}
	
	public ImageView getCat () {
		return catImgView;
	}
	
	//The strings returned are randomized in the number part, from min --> max-1
//	public String getString() {
//		int num = random.nextInt(MIN_VAL, MAX_VAL);
//		imageLocation = imageLocation + num + ".png";
//		return imageLocation;
//	}
}
