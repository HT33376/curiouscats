<fx:controller="meat.MainController">
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- for Button, Label,... -->

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="meat.MainController">
   <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <VBox fx:id="vbox" alignment="CENTER" spacing="25.0">
            <children>
                <Button fx:id="startButton" alignment="CENTER" onAction="#switchStart" prefHeight="40.0" prefWidth="300.0" text="Start" />
                <Button fx:id="galleryButton" alignment="CENTER" onAction="#switchGallery" prefHeight="40.0" prefWidth="300.0" text="Gallery" />
                <Button fx:id="settingButton" alignment="CENTER" onAction="#switchSetting" prefHeight="40.0" prefWidth="300.0" text="Setting" />
                <Button fx:id="creditButton" alignment="CENTER" onAction="#switchCredit" prefHeight="40.0" prefWidth="300.0" text="Credit" />
            </children>
         </VBox>
      </children>
   </StackPane>

      </AnchorPane>
