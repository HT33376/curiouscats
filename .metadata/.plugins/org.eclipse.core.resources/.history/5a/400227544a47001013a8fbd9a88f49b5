package meat;

import java.io.IOException;

import javafx.animation.Timeline;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;

public class MainController {

	    @FXML private Button switchSceneButton;
	    @FXML private Button startTimerButton;

	    @FXML
	    private void switchScene() throws IOException {
	        Parent settingsRoot = FXMLLoader.load(getClass().getResource("/SettingsView.fxml"));
	        Scene scene = switchSceneButton.getScene();
	        scene.setRoot(settingsRoot);
	    }

	    @FXML
	    private void startTimer() {
	        Timeline timer = new Timeline(9);
	        timer.setCycleCount(Timeline.INDEFINITE);
	        timer.play();
	    }

}
