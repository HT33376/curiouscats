    @FXML
    private void switchSettings(ActionEvent event) throws IOException {
        Parent mainRoot = FXMLLoader.load(getClass().getResource("/SettingsView.fxml"));
        Scene mainScene = new Scene(mainRoot, 800, 600);
        mainScene.setFill(Color.RED);



        // Get current stage from button
        Stage stage = (Stage) settingsButton.getScene().getWindow();
        stage.setScene(mainScene);
        stage.show();
    }
    
    @FXML
    private void switchCredit() throws IOException {  
        Parent settingsRoot = FXMLLoader.load(getClass().getResource("/MainView.fxml"));
        Scene scene = startButton.getScene();
        scene.setRoot(settingsRoot);
    }

    
    //Action of the start timer button(removed)
    @FXML
    private void startTimer() {
        Timeline timer = new Timeline(new KeyFrame(Duration.seconds(1), event -> {
            System.out.println("Timer tick");
        }));
        timer.setCycleCount(Timeline.INDEFINITE);
        timer.play();
    }

