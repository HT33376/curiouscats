<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<!-- for Button, Label,... -->

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="meat.LauncherController">
  <Button fx:id="pauseButton" layoutX="508.0" layoutY="367.0" onAction="#switchPause" prefHeight="40.0" prefWidth="200.0" text="Pause" />
  <Button fx:id="launchButton" alignment="CENTER" layoutX="508.0" layoutY="297.0" onAction="#switchStart" prefHeight="40.0" prefWidth="200.0" text="Launch" />
  <Button fx:id="backButton" alignment="CENTER" layoutX="14.0" layoutY="14.0" onAction="#switchBack" prefHeight="16.0" prefWidth="59.0" text="Back" />
   <ScrollPane hbarPolicy="NEVER" layoutX="14.0" layoutY="47.0" prefHeight="539.0" prefWidth="200.0" vbarPolicy="ALWAYS">
     <content>
		<VBox fx:id="imageLogBar" prefWidth="200.0" />
     </content>
   </ScrollPane>
   <VBox fx:id ="timerBox" layoutX="227.0" layoutY="454.0" prefHeight="132.0" prefWidth="562.0" />
   <VBox fx:id="mostRecentPng" layoutX="263.0" layoutY="207.0" prefHeight="200.0" prefWidth="200.0" />
</AnchorPane>
